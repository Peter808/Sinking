  "social": {
    "bluesky": {
      "_comment": "Public post search. Each hashtag is searched; posts must ALSO contain a location term from keywords.json. Bluesky may require auth for search; verified in step 5.",
      "endpoint": "https://public.api.bsky.app/xrpc/app.bsky.feed.searchPosts",
      "hashtags": ["#KingTide", "#MiamiFlooding", "#SunnyDayFlooding", "#SeaLevelRise"],
      "status": "unverified"
    },
    "reddit": {
      "_comment": "Subreddit search RSS. Shows title, subreddit, link only. Reddit sometimes blocks automated requests from cloud servers; verified in step 5.",
      "subreddits": ["Miami", "MiamiBeach", "fortlauderdale", "SouthFlorida"],
      "urlPattern": "https://www.reddit.com/r/{subreddit}/search.rss?q=flood+OR+flooding+OR+%22king+tide%22&restrict_sr=on&sort=new",
      "status": "unverified"
    }
  },

  "limits": { "newsMax": 60, "socialMax": 40 }
}
