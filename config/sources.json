  "social": {
    "bluesky": {
      "_comment": "Public post search (api.bsky.app works; public.api.bsky.app returns 403). Posts must ALSO contain a location term from keywords.json. Auto-published after filters.",
      "endpoint": "https://api.bsky.app/xrpc/app.bsky.feed.searchPosts",
      "hashtags": [
        "#KingTide",
        "#MiamiFlooding",
        "#SunnyDayFlooding",
        "#SeaLevelRise"
      ],
      "status": "unverified"
    },
    "reddit": {
      "_comment": "Subreddit search RSS. Title, subreddit, link only. VETTED: new posts go to a daily GitHub review issue; only ticked posts publish. Reddit sometimes rate-limits cloud servers.",
      "subreddits": [
        "Miami",
        "MiamiBeach",
        "fortlauderdale",
        "SouthFlorida"
      ],
      "urlPattern": "https://www.reddit.com/r/{subreddit}/search.rss?q=flood+OR+flooding+OR+%22king+tide%22&restrict_sr=on&sort=new",
      "status": "unverified",
      "review": true
    }
  },
  "limits": {
    "newsMax": 60,
    "socialMax": 40
  }
}
